# ══════════════════════════════════════════════════════════════
#  Ravand — نمونهٔ متغیرهای محیطی
#  استفاده:  cp .env.example .env
#  این فایل تنها مرجع متغیرهاست؛ اگر متغیری اضافه کردی، حتماً
#  اسکیمای Joi در apps/api/src/config/env.ts را هم آپدیت کن.
# ══════════════════════════════════════════════════════════════

# محیط اجرا: development | production | test
NODE_ENV=development

# ─────────────────────────────── API ───────────────────────────────
# پورتی که سرور API روی آن گوش می‌دهد
API_PORT=4444

# دامنه‌هایی که اجازهٔ درخواست به API را دارند (با کاما جدا شوند)
CORS_ORIGINS=http://localhost:3333

# سطح لاگ (اختیاری): log | error | warn | debug | verbose
# اگر خالی باشد، بر اساس NODE_ENV انتخاب می‌شود
# LOG_LEVEL=debug

# اجرای خودکار مایگریشن‌ها در زمان بالا آمدن سرویس (فقط در کانتینر)
# RUN_MIGRATIONS=false

# ───────────────────────────── دیتابیس ─────────────────────────────
# نکته: پورت میزبانِ MySQL در docker-compose برابر 3307 است
DB_HOST=localhost
DB_PORT=3307
DB_NAME=ravand
DB_USER=ravand
DB_PASSWORD=ravand_dev_password

# ──────────────────────────────── وب ───────────────────────────────
# آدرس ریشهٔ API — فقط سمت سرور استفاده می‌شود:
#   • رندر سمت سرور (SSR)
#   • ریوایت /api/* در next.config.ts
# مرورگر هیچ‌وقت مستقیم به این آدرس درخواست نمی‌زند (از /api/v1 روی همان دامنه).
API_URL=http://localhost:4444
