{
  "name": "@ravand/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, enums and helpers between the API and the web app",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node ../../scripts/clean.mjs dist .turbo tsconfig.tsbuildinfo",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@ravand/tsconfig": "*",
    "typescript": "^5.8.2"
  }
}
