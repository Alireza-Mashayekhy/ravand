{
  "name": "@ravand/api",
  "version": "0.1.0",
  "private": true,
  "description": "Ravand API — NestJS + TypeORM + MySQL",
  "scripts": {
    "build": "nest build",
    "clean": "node ../../scripts/clean.mjs dist .turbo tsconfig.tsbuildinfo",
    "db:migration:create": "typeorm-ts-node-commonjs migration:create",
    "db:migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "db:migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "db:seed": "ts-node src/database/seeds/seed.ts",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@ravand/contracts": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "joi": "^18.2.9",
    "mysql2": "^3.24.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@ravand/eslint-config": "workspace:*",
    "@ravand/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
