{
  "name": "@ravand/web",
  "version": "0.1.0",
  "private": true,
  "description": "Ravand Web — Next.js (App Router) + React Query + Tailwind v4",
  "scripts": {
    "build": "next build",
    "clean": "node ../../scripts/clean.mjs .next .turbo tsconfig.tsbuildinfo",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ravand/contracts": "*",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/env": "^16.3.8",
    "@ravand/eslint-config": "*",
    "@ravand/tsconfig": "*",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5.8.2"
  }
}
