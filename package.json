{
  "name": "ravand",
  "version": "0.1.0",
  "private": true,
  "description": "Ravand — سامانه مدیریت کارها، پروژه‌ها و زمان (Next.js + NestJS + TypeScript)",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ravand/web",
    "build": "npm run build --workspace=@ravand/contracts && npm run build --workspace=@ravand/web",
    "start": "npm run start --workspace=@ravand/web",
    "clean": "node ./scripts/clean.mjs .turbo .next dist apps/*/.next apps/*/dist packages/*/dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace=@ravand/web",
    "typecheck": "npm run typecheck --workspace=@ravand/contracts && npm run typecheck --workspace=@ravand/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
